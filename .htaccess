# Proxy all requests to the Node.js backend (adjust port if needed)
# This file is for Apache shared hosting that proxies to Node.js

# Handle CORS preflight OPTIONS requests at the Apache level
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
Header always set Access-Control-Max-Age "86400"

# Return 200 for OPTIONS preflight requests immediately
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]
